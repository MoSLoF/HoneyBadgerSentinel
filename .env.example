# HoneyBadger Sentinel - Environment Configuration Example
# Copy this file to .env or set these as environment variables.
# For systemd services, edit /etc/hbv-sentinel/collector.env or /etc/hbv-sentinel/agent.env.
#
# SECURITY DEFAULTS (v1.1.1+):
#   - Collector binds to loopback (127.0.0.1). Change HBV_HOST only after you
#     have TLS + a real API key in place.
#   - Authentication is REQUIRED by default. Every data endpoint (including
#     /metrics) returns 401 without a valid X-API-Key header.
#   - CORS starts EMPTY (the bundled dashboard is same-origin and needs none).
#     A wildcard "*" is auto-downgraded to allow_credentials=false.
#   - Agent refuses cleartext HTTP unless HBV_ALLOW_INSECURE=true is set.

# ═══════════════════════════════════════════════════════════════════════
# COLLECTOR CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════

# Server Settings — leave on loopback until a TLS-terminating reverse proxy is
# in front. Binding to 0.0.0.0 without one exposes an authenticated but
# cleartext channel; the collector logs a warning if you do.
HBV_HOST=127.0.0.1
HBV_PORT=8443

# Database
HBV_DB_PATH=/opt/hbv-sentinel/sentinel.db
HBV_RETENTION_DAYS=30

# Authentication
# Auth REQUIRED by default. Do not disable this on a network-reachable host.
HBV_API_KEY_REQUIRED=true
# Generate with: python3 sentinel-collector.py --generate-key
# Leave commented to use an EPHEMERAL key (regenerates on every restart) —
# useful only for quick local smoke tests.
# HBV_API_KEY=paste-a-secure-random-token-here

# CORS (comma-separated list of allowed origins). Leave EMPTY for same-origin
# use; the bundled dashboard needs no cross-origin permission. A literal "*"
# is honored but credentials are force-disabled with a warning.
HBV_ALLOWED_ORIGINS=

# Beacon freshness / replay window (seconds). Beacons whose timestamp is
# outside ±this-many seconds of now are rejected; verbatim duplicates inside
# the window are also rejected.
HBV_BEACON_MAX_SKEW=300

# FastAPI /docs, /redoc, /openapi.json — DISABLED in production. Set to true
# only in a local development instance where schema browsing is useful.
HBV_ENABLE_DOCS=false

# Interactive dashboard shell at GET /. DISABLED in production so the ONLY
# anonymous public route is /health. Enable only from a management origin
# behind reverse-proxy access control (IP allowlist, mTLS, management VLAN).
HBV_ENABLE_DASHBOARD=false

# Rate Limiting
HBV_RATE_LIMIT_REQUESTS=100
HBV_RATE_LIMIT_WINDOW=60

# Alert Thresholds (percentage/degrees)
HBV_ALERT_CPU=90
HBV_ALERT_MEMORY=90
HBV_ALERT_DISK=90
HBV_ALERT_GPU_TEMP=85

# Logging (DEBUG, INFO, WARNING, ERROR)
HBV_LOG_LEVEL=INFO

# ═══════════════════════════════════════════════════════════════════════
# AGENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════

# Agent Identity (defaults to hostname)
# HBV_AGENT_ID=my-server-01

# Collector URL — HTTPS required by default. The agent refuses to POST over
# plain HTTP because the beacon carries the API key and full host telemetry.
HBV_COLLECTOR_URL=https://<COLLECTOR_HOST>:8443/api/beacon

# API Key — MUST match the collector's HBV_API_KEY exactly.
# HBV_API_KEY=paste-the-same-token-as-the-collector

# TLS trust anchor for a private/self-signed collector cert (recommended).
# HBV_TLS_CA_BUNDLE=/etc/hbv-sentinel/ca.pem
# Setting HBV_TLS_CA_BUNDLE=false disables verification entirely (LAB ONLY).

# Cleartext HTTP override for lab/loopback bring-up only. Do NOT enable this
# on any host that can be reached from another machine.
HBV_ALLOW_INSECURE=false

# Beacon Settings
HBV_BEACON_INTERVAL=30
HBV_MAX_RETRIES=3
HBV_RETRY_DELAY=5
HBV_REQUEST_TIMEOUT=10

# Queue Settings
HBV_QUEUE_PATH=/tmp/hbv-sentinel-queue
HBV_MAX_QUEUE_SIZE=100

# Metrics Collection (true/false)
HBV_COLLECT_CPU=true
HBV_COLLECT_MEMORY=true
HBV_COLLECT_DISK=true
HBV_COLLECT_NETWORK=true
HBV_COLLECT_TEMPERATURE=true
HBV_COLLECT_RAID=true
HBV_COLLECT_SERVICES=true
HBV_COLLECT_GPU=true

# Logging
HBV_LOG_PATH=/var/log/hbv-sentinel.log
# HBV_LOG_LEVEL=INFO
