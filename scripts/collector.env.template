# HoneyBadger Sentinel Collector Configuration
# Materialized by install-collector.sh on fresh install.
# Every setting reflects the hardened production defaults; change only after
# you have a matching mitigation in place (TLS proxy, firewall, etc.).

# ── Network exposure ──────────────────────────────────────────────────
# Loopback until you have a TLS-terminating reverse proxy in front.
HBV_HOST=127.0.0.1
HBV_PORT=8443

# ── Storage ───────────────────────────────────────────────────────────
HBV_DB_PATH=/opt/hbv-sentinel/sentinel.db
HBV_RETENTION_DAYS=30

# ── Authentication (REQUIRED — do not disable on a reachable host) ────
HBV_API_KEY_REQUIRED=true
HBV_API_KEY=__HBV_API_KEY__

# ── CORS (empty by default; the bundled dashboard is same-origin) ─────
HBV_ALLOWED_ORIGINS=

# ── Beacon freshness / replay window (seconds) ────────────────────────
HBV_BEACON_MAX_SKEW=300

# ── Rate limiting ─────────────────────────────────────────────────────
HBV_RATE_LIMIT_REQUESTS=100
HBV_RATE_LIMIT_WINDOW=60

# ── FastAPI docs surface (off in production) ──────────────────────────
HBV_ENABLE_DOCS=false

# ── Dashboard shell (off in production; enable in a management origin) ─
HBV_ENABLE_DASHBOARD=false

# ── Alert thresholds ──────────────────────────────────────────────────
HBV_ALERT_CPU=90
HBV_ALERT_MEMORY=90
HBV_ALERT_DISK=90
HBV_ALERT_GPU_TEMP=85

# ── Logging ───────────────────────────────────────────────────────────
HBV_LOG_LEVEL=INFO
